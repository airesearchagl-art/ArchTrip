    "This can't be undone." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作は取り消せません。"
          }
        }
      }
    },
    "This changes this anonymous account into an account for syncing between devices. Your current data is kept; only sign-in details are added." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この匿名アカウントを端末間同期用アカウントへ変更します。現在のデータを保持したまま認証情報を追加します。"
          }
        }
      }
    },
    "This deletion is kept in the trip list until the server confirms it, also after a restart." : {
