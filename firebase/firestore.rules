rules_version = '2';

// ArchTrip: each signed-in user can only access their own data under users/{uid}:
// trips/** (Trips and their Events) and buildings/*. Everything else is denied by default.
//
// Optional model fields (Building.completedYear/latitude/longitude/applePlaceId, Event.buildingId,
// Event.isAllDay, Event.checkInMinutes/checkOutMinutes, Event.pickupMinutes/returnMinutes,
// Event.travelPoint) are omitted from documents when unset (Firestore.Encoder skips nil), so
// they may be absent.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidTrip(tripId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'title', 'destination', 'startDate', 'endDate', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['id', 'title', 'destination', 'startDate', 'endDate', 'createdAt', 'updatedAt'])
        && d.id == tripId
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.destination is string && d.destination.size() <= 200
        && d.startDate is timestamp && d.endDate is timestamp && d.endDate >= d.startDate
        && d.createdAt is timestamp && d.updatedAt is timestamp && d.updatedAt >= d.createdAt;
    }

    // A hotel stay's optional clock time (G6-UX-05): minutes after local midnight on the
    // check-in day or the check-out day, on all-day hotel Events only.
    function isHotelClockTime(d, minutes) {
      return minutes is int && minutes >= 0 && minutes < 1440
        && d.type == 'hotel' && ('isAllDay' in d) && d.isAllDay == true;
    }

    // A rental car's optional clock time (G6-UX-07): minutes after local midnight on the
    // pickup day or the return day, on all-day car Events only.
    function isCarClockTime(d, minutes) {
      return minutes is int && minutes >= 0 && minutes < 1440
        && d.type == 'car' && ('isAllDay' in d) && d.isAllDay == true;
    }

    // Optional travel point of an Event (travel MVP): either a Place ID the user picked,
    // kept verbatim, or the search text the user typed. Never a name, address or
    // coordinates from Apple Maps, never a route or a time. The 128 / 200 are this
    // project's write-time bounds (TravelPointSetting.placeIdMaxLength / queryMaxLength),
    // not an Apple format; the app never checks them when reading.
    function isValidTravelPoint(p) {
      return p is map
        && (
          (p.keys().hasOnly(['kind', 'placeId']) && p.keys().hasAll(['kind', 'placeId'])
            && p.kind == 'place' && p.placeId is string && p.placeId.size() >= 1 && p.placeId.size() <= 128)
          || (p.keys().hasOnly(['kind', 'query']) && p.keys().hasAll(['kind', 'query'])
            && p.kind == 'query' && p.query is string && p.query.size() >= 1 && p.query.size() <= 200)
        );
    }

    function isValidEvent(tripId, eventId) {
      let d = request.resource.data;
      let fields = ['id', 'tripId', 'type', 'title', 'startDate', 'endDate', 'locationName', 'note', 'createdAt', 'updatedAt'];
      return d.keys().hasOnly(fields.concat(['buildingId', 'isAllDay', 'checkInMinutes', 'checkOutMinutes', 'pickupMinutes', 'returnMinutes', 'travelPoint']))
        && d.keys().hasAll(fields)
        && d.id == eventId
        && d.tripId == tripId
        && d.type in ['flight', 'train', 'car', 'walk', 'hotel', 'business', 'architecture', 'food', 'other']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.locationName is string && d.locationName.size() <= 200
        && d.note is string && d.note.size() <= 2000
        && d.startDate is timestamp && d.endDate is timestamp && d.endDate >= d.startDate
        && d.createdAt is timestamp && d.updatedAt is timestamp && d.updatedAt >= d.createdAt
        // Optional Building link: architecture Events only. The Building's existence is
        // intentionally not required, so Events stay editable after a Building is deleted.
        && (!('buildingId' in d)
          || (d.buildingId is string && d.buildingId.size() > 0 && d.buildingId.size() <= 200
            && d.type == 'architecture'))
        // Optional all-day flag (G6): stays, rental cars and whole-day notes are listed apart
        // from the timed timeline. Absent or false means a timed Event, so every document
        // written before G6 keeps its meaning without being touched.
        && (!('isAllDay' in d) || d.isAllDay is bool)
        && (!('checkInMinutes' in d) || isHotelClockTime(d, d.checkInMinutes))
        && (!('checkOutMinutes' in d) || isHotelClockTime(d, d.checkOutMinutes))
        && (!('pickupMinutes' in d) || isCarClockTime(d, d.pickupMinutes))
        && (!('returnMinutes' in d) || isCarClockTime(d, d.returnMinutes))
        // Optional travel point: validated on the stored document as a whole, so an Event
        // carrying a value outside these bounds must have it cleared before other edits.
        && (!('travelPoint' in d) || isValidTravelPoint(d.travelPoint));
    }

    function tripExists(userId, tripId) {
      return exists(/databases/$(database)/documents/users/$(userId)/trips/$(tripId));
    }

    function isValidBuilding(buildingId) {
      let d = request.resource.data;
      let required = ['id', 'name', 'architect', 'address', 'visitMinutes', 'priority', 'visited', 'note', 'createdAt', 'updatedAt'];
      return d.keys().hasAll(required)
        && d.keys().hasOnly(required.concat(['completedYear', 'latitude', 'longitude', 'applePlaceId']))
        && d.id == buildingId
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.architect is string && d.architect.size() <= 200
        && d.address is string && d.address.size() <= 300
        && d.note is string && d.note.size() <= 2000
        && d.visitMinutes is int && d.visitMinutes >= 5 && d.visitMinutes <= 480
        && d.priority is int && d.priority >= 1 && d.priority <= 3
        && d.visited is bool
        && (!('completedYear' in d)
          || (d.completedYear is int && d.completedYear >= 1 && d.completedYear <= 2100))
        // Coordinates are a pair: both present or both absent.
        && ('latitude' in d) == ('longitude' in d)
        && (!('latitude' in d)
          || (d.latitude is number && d.latitude >= -90 && d.latitude <= 90
            && d.longitude is number && d.longitude >= -180 && d.longitude <= 180))
        // Optional Apple Maps Place ID (v0.2): an opaque string kept as MapKit gave it. The
        // 128 is this project's defensive bound (Building.applePlaceIdMaxLength), not an
        // Apple limit. It may sit beside legacy coordinates; the app then ignores those.
        && (!('applePlaceId' in d)
          || (d.applePlaceId is string && d.applePlaceId.size() >= 1 && d.applePlaceId.size() <= 128))
        && d.createdAt is timestamp && d.updatedAt is timestamp && d.updatedAt >= d.createdAt;
    }

    match /users/{userId}/trips/{tripId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && isValidTrip(tripId);
      allow update: if isOwner(userId) && isValidTrip(tripId)
        && request.resource.data.createdAt == resource.data.createdAt;

      // Events may only be written below an existing Trip of the same user.
      match /events/{eventId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidEvent(tripId, eventId) && tripExists(userId, tripId);
        allow update: if isOwner(userId) && isValidEvent(tripId, eventId) && tripExists(userId, tripId)
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }

    // Buildings are user-owned and reusable across Trips. Deleting one leaves Events intact.
    match /users/{userId}/buildings/{buildingId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && isValidBuilding(buildingId);
      allow update: if isOwner(userId) && isValidBuilding(buildingId)
        && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
